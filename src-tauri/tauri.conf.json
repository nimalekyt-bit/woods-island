{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Woods Island",
  "version": "1.0.0",
  "identifier": "com.woods.island",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Woods Island",
        "label": "main",
        "focus": false,
        "width": 760,
        "height": 480,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "noRedirectionBitmap": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "shadow": false
      },
      {
        "title": "Woods Island — настройки",
        "label": "settings",
        "focus": false,
        "url": "settings.html",
        "width": 820,
        "height": 720,
        "minWidth": 660,
        "minHeight": 480,
        "resizable": true,
        "decorations": true,
        "visible": false,
        "center": true
      },
      {
        "title": "Woods Island — захват экрана",
        "label": "overlay",
        "focus": false,
        "url": "overlay.html",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "title": "Woods Island — разметка",
        "label": "editor",
        "focus": false,
        "url": "editor.html",
        "width": 900,
        "height": 680,
        "resizable": true,
        "decorations": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
