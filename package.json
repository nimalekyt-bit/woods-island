{
  "name": "woods-island",
  "version": "1.1.1",
  "description": "Dynamic Island HUD for Windows 10 & 11 (Woods Corp)",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.runtime.config.ts",
    "build": "node scripts/generate-ipc.mjs --check && tsc -p tsconfig.runtime.json && vite build --config vite.runtime.config.ts && node scripts/build-runtime.mjs",
    "check:runtime": "node scripts/generate-ipc.mjs --check && tsc -p tsconfig.runtime.json && node scripts/build-runtime.mjs --check",
    "test:hooks": "node --test scripts/island-notify.test.cjs",
    "test:runtime-state": "node --test scripts/runtime-state.test.cjs scripts/island-events.test.cjs scripts/island-geometry.test.cjs",
    "test:ipc": "node --test scripts/ipc-generation.test.cjs",
    "test:characters": "node --test scripts/character-engine.test.cjs scripts/character-pixel.test.cjs scripts/character-state.test.cjs scripts/liquid-engine.test.cjs scripts/character-attached.test.cjs scripts/bitmap-character.test.cjs scripts/pet-library.test.cjs",
    "check:authors": "node scripts/check-commit-owners.mjs",
    "test:native": "node scripts/verify-runtime.cjs",
    "test:controls": "node scripts/verify-controls.cjs",
    "package:portable": "node scripts/package-portable.mjs",
    "dev:prototype": "vite",
    "build:prototype": "tsc && vite build --outDir dist-prototype",
    "preview": "vite preview",
    "tauri": "tauri",
    "generate:ipc": "node scripts/generate-ipc.mjs",
    "test:performance": "node scripts/verify-performance.cjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-global-shortcut": "^2.2.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.2.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "3.6.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
